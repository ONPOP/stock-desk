# Supabase runtime
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side encryption and cron
APP_ENCRYPTION_KEY=
CRON_SECRET=
SEC_EDGAR_USER_AGENT=

# Migration only
SUPABASE_DB_URL=

# 분석 엔진 슬라이드 저장 루트 (D16). 배치(스크립트)와 데스크톱 앱이 같은 곳을 보게 하려면 절대경로로 지정한다.
# 비워두면 각자의 실행 디렉토리 기준으로 갈라진다 — 앱은 앱 번들 안, 배치는 리포지토리 안.
# 홈 디렉토리 또는 /Volumes/<볼륨> 하위만 허용된다. 앱에는 재패키징(npm run app:dist) 시 반영된다.
SLIDE_STORAGE_ROOT=

# Optional CLI verification/sync scripts only.
# Runtime user provider keys are saved from the Settings screen.
KIS_APP_KEY=
KIS_APP_SECRET=
DART_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OPENAI_API_KEY=
